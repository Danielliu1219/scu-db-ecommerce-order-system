{
  "name": "scu-ecommerce-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.json *.ts index.html",
    "format:check": "prettier --check src tests *.json *.ts index.html",
    "gen:api": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/types/api.ts"
  },
  "dependencies": {
    "element-plus": "^2.9.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.6.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  }
}
